# ─── Discord ───────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here

# ─── AI Models (Usa Groq che è gratis!) ───
# La chiave Groq la prendi da console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ─── HyperLiquid (OPZIONALE per demo) ──────
# Lascia vuoti per modalità DEMO — il bot funziona lo stesso!
# Il trading sarà simulato con prezzi reali di mercato.
HL_PRIVATE_KEY=
HL_WALLET_ADDRESS=

# ─── Bot Mode ──────────────────────────────
# DRY_RUN=True → trade simulati (consigliato per demo)
DRY_RUN=True
# USE_TESTNET=True → usa HL Testnet con soldi finti
USE_TESTNET=False
